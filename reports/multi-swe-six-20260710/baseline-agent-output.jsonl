 name##_remove(name_t* map, type* entry); \\\n  void name##_removeindex(name_t* map, size_t index); \\\n  void name##_clearindex(name_t* map, size_t index); \\\n  size_t name##_size(name_t* map); \\\n  type* name##_next(name_t* map, size_t* i); \\\n\n#define DECLARE_HASHMAP_SERIALISE(name, name_t, type) \\\n  DECLARE_HASHMAP(name, name_t, type) \\\n  void name##_serialise_trace(pony_ctx_t* ctx, void* object); \\\n  void name##_serialise(pony_ctx_t* ctx, void* object, void* buf, \\\n    size_t offset, int mutability); \\\n","exit_code":0,"status":"completed"}}
