ind(LLVMTypeOf(r_value)) == LLVMStructTypeKind);\n      }\n\n      return assign_to_tuple(c, l_type, r_value, type);\n\n    default: {}\n  }\n\n  pony_assert(0);\n  return NULL;\n}\n","exit_code":0,"status":"completed"}}
