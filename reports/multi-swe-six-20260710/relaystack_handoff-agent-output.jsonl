LLVMTypeRef f_type = LLVMFunctionType(r_type, f_params, count, false);\n\n  if(f_params != NULL)\n    ponyint_pool_free_size(buf_size, f_params);\n\n  return f_type;\n}\n\nstatic LLVMValueRef declare_ffi(compile_t* c, const char* f_name,\n  LLVMTypeRef f_type)\n{\n  return LLVMAddFunction(c->module, f_name, f_type);\n}\n\nstatic bool ffi_signature_matches(compile_t* c, ast_t* ast, const char* f_name,\n  LLVMValueRef func, LLVMTypeRef expected_type)\n{\n  LLVMTypeRef existing_type = LLVMGetElementType(LLVMTypeOf(func));\n\n  if(existing_type == expected_type)\n    return true;\n\n  ast_t* decl = (ast_t*)ast_data(ast);\n  ast_t* error_at = (decl != NULL) ? decl : ast;\n\n  ast_error(c->opt->check.errors, error_at,\n    \"FFI function '%s' has an incompatible declaration\", f_name);\n  ast_error_continue(c->opt->check.errors, ast,\n    \"the FFI function was previously declared with a different signature\");\n  return false;\n}\n\nstatic LLVMValueRef cast_ffi_arg(compile_t* c, LLVMValueRef arg,\n  LLVMTypeRef param)\n{\n  if(arg == NULL)\n    return NULL;\n\n  LLVMTypeRef arg_type = LLVMTypeOf(arg);\n\n  switch(LLVMGetTypeKind(param))\n  {\n    case LLVMPointerTypeKind:\n    {\n      if(LLVMGetTypeKind(arg_type) == LLVMIntegerTypeKind)\n        arg = LLVMBuildIntToPtr(c->builder, arg, param, \"\");\n      else\n        arg = LLVMBuildBitCast(c->builder, arg, param, \"\");\n\n      break;\n    }\n\n    default: {}\n  }\n\n  return arg;\n}\n\nLLVMValueRef gen_ffi(compile_t* c, ast_t* ast)\n{\n  AST_GET_CHILDREN(ast, id, typeargs, args, named_args, can_err);\n  bool err = (ast_id(can_err) == TK_QUESTION);\n\n  // Get the function name, +1 to skip leading @\n  const char* f_name = ast_name(id) + 1;\n\n  // Get the return type.\n  ast_t* type = ast_type(ast);\n  reach_type_t* t = reach_type(c->reach, type);\n  pony_assert(t != NULL);\n\n  // Get the function.\n  ast_t* decl = (ast_t*)ast_data(ast);\n  LLVMTypeRef expected_type;\n  LLVMValueRef func = LLVMGetNamedFunction(c->module, f_name);\n\n  if(decl != NULL)\n  {\n    // Define using the declared types.\n    AST_GET_CHILDREN(decl, decl_id, decl_ret, decl_params, decl_err);\n    err = (ast_id(decl_err) == TK_QUESTION);\n    expected_type = ffi_type(c, t, decl_params, false);\n  } else if(!strncmp(f_name, \"llvm.\", 5) || !strncmp(f_name, \"internal.\", 9)) {\n    // Intrinsic, so use the exact types we supply.\n    expected_type = ffi_type(c, t, args, true);\n  } else {\n    // Make it varargs.\n    expected_type = ffi_vararg_type(c, t);\n  }\n\n  if(func == NULL)\n    func = declare_ffi(c, f_name, expected_type);\n  else if(!ffi_signature_matches(c, ast, f_name, func, expected_type))\n    return NULL;\n","exit_code":0,"status":"completed"}}
