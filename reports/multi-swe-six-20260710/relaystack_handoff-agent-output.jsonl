{"type":"item.completed","item":{"id":"item_26","type":"command_execution","command":"/bin/zsh -lc \"sed -n '1260,1334p' src/libponyc/ast/lexer.c\"","aggregated_output":"token_t* lexer_next(lexer_t* lexer)\n{\n  pony_assert(lexer != NULL);\n\n  token_t* t = NULL;\n\n  while(t == NULL)\n  {\n    lexer->token_line = lexer->line;\n    lexer->token_pos = lexer->pos;\n    lexer->buflen = 0;\n\n    if(is_eof(lexer))\n    {\n      t = make_token(lexer, TK_EOF);\n      break;\n    }\n\n    char c = look(lexer);\n\n    switch(c)\n    {\n      case '\\n':\n        lexer->newline = true;\n        consume_chars(lexer, 1);\n        break;\n\n      case '\\r':\n      case '\\t':\n      case ' ':\n        consume_chars(lexer, 1);\n        break;\n\n      case '/':\n        t = slash(lexer);\n        break;\n\n      case '\\\"':\n        t = string(lexer);\n        break;\n\n      case '\\'':\n        t = character(lexer);\n        break;\n\n      case '#':\n        t = hash(lexer);\n        break;\n\n      case '$':\n        t = dollar(lexer);\n        break;\n\n      default:\n        if(isdigit(c))\n        {\n          t = number(lexer);\n        }\n        else if(isalpha(c) || (c == '_'))\n        {\n          t = keyword(lexer, true);\n          pony_assert(t != NULL);\n        }\n        else\n        {\n          t = symbol(lexer);\n        }\n    }\n  }\n\n  lexer->newline = false; // We've found a symbol, so no longer a new line\n  return t;\n}\n\n\n","exit_code":0,"status":"completed"}}
